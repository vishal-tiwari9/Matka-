# =============================================================================
# — Environment Variables (Monad Testnet)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# =============================================================================

# --- Allium (optional — for live cross-chain wallet scoring) ---
# Without this key, pipeline uses cached/synthetic data (demo mode). That's fine!
# Get a key at: https://app.allium.so
ALLIUM_API_KEY=

# --- Monad Testnet ---
# Chain ID: 10143  |  Explorer: https://testnet.monadexplorer.com
# Get free MON at: https://faucet.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_PRIVATE_KEY=

# --- Deployed Contract Addresses (Monad Testnet) ---
# Leave blank until you deploy. After running DeployMonad.s.sol, paste addresses here.
ATTESTATION_REGISTRY_ADDRESS=
CREDIT_ORACLE_ADDRESS=
LENDING_POOL_ADDRESS=

# --- Frontend Vite Env (also create frontend/.env with these) ---
VITE_REGISTRY_ADDRESS=
VITE_ORACLE_ADDRESS=
VITE_POOL_ADDRESS=
VITE_API_URL=
